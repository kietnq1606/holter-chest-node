#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    aliases {
        storage-flash = &w25n01gv;
    };

    ad8232: ad8232 {
        compatible = "adi,ad8232";              /* Bind node to AD8232 driver */

        io-channels = <&adc 0>;                 /* Connect AD8232 output to ADC */

        lo-plus-gpios  = <&gpio0 22 GPIO_ACTIVE_HIGH>;  /* Read LO+ status */
        lo-minus-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;  /* Read LO- status */

        status = "okay";                        /* Enable device */
    };
};

&adc {
    status = "okay";                            /* Enable ADC peripheral */

    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;                              /* Select ADC channel 0 */

        zephyr,gain = "ADC_GAIN_1_6";           /* Configure ADC gain */
        zephyr,reference = "ADC_REF_INTERNAL";  /* Use internal ADC reference */
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>; /* Set acquisition time */

        zephyr,input-positive = <NRF_SAADC_AIN0>; /* Select analog input */

        zephyr,resolution = <12>;               /* Set 12-bit resolution */
    };
};

&i2c0 {
    status = "okay";                            /* Enable I2C controller */

    pinctrl-0 = <&i2c0_default>;                /* Use normal I2C pin state */
    pinctrl-1 = <&i2c0_sleep>;                  /* Use low-power pin state */
    pinctrl-names = "default", "sleep";         /* Define available pin states */

    clock-frequency = <I2C_BITRATE_STANDARD>;   /* Set I2C speed */

    bmi323: bmi323@68 {
        compatible = "bosch,bmi323";            /* Bind node to BMI323 driver */

        reg = <0x68>;                           /* Set sensor I2C address */

        int-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>; /* Receive sensor interrupt */

        status = "okay";                        /* Enable sensor */
    };
};
&i2c1 {
    status = "disabled";
};
&uart0 {
    status = "disabled";
};
&spi2 {
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-1 = <&spi2_sleep>;
    pinctrl-names = "default", "sleep";

    /* Active-low chip select for the NAND. */
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    w25n01gv: flash@0 {
        compatible = "jedec,spi-nand";
        reg = <0>; /* Uses chip-select entry 0. */
        /* nRF52840 SPIM2 limit; W25N01GV supports a higher clock. */
        spi-max-frequency = <8000000>;
        jedec-id = [ef aa 21]; /* W25N01GV manufacturer and device ID. */
        size-bytes = <134217728>; /* Total capacity: 1 Gbit = 128 MiB. */
        erase-block-size = <131072>; /* Physical erase block: 64 × 2048-byte pages. */
        write-block-size = <2048>; /* NAND page-program size. */
        /* Maximum operation times in microseconds; follow the chip datasheet. */
        block-erase-duration-max = <10000>;
        page-program-duration-max = <700>;
        page-read-duration-max = <100>;
        reset-duration-max = <500>;
        status = "okay";
    };
};
